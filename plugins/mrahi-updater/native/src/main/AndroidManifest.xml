<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- لتثبيت ملف APK المحمَّل ذاتياً (تحديث التطبيق) — أندرويد ٨+ يتطلّب هذا الإذن صراحةً -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- يشارك مسار ملف APK المحمَّل (داخل مساحة التطبيق الخاصة) مع مثبّت النظام بأمان دون كشف مسارات أخرى.
             دامج مانيفست أندرويد يُطابق عناصر <provider> بحسب android:name لا android:authorities — فاستخدام
             الاسم العام "androidx.core.content.FileProvider" (كما تفعل @capacitor/local-notifications أصلاً)
             يُسبّب فشل الدمج حتى مع سلطة مختلفة، لذا UpdaterFileProvider فئة فرعية فارغة باسم فريد لهذه الإضافة. -->
        <provider
            android:name="me.alaoufi.mrahi.updater.UpdaterFileProvider"
            android:authorities="${applicationId}.updaterprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mrahi_updater_file_paths" />
        </provider>
    </application>
</manifest>
